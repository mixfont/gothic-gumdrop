name: "Gothic Gumdrop"
designer: "Eric Lu, Alex Kaczun"
license: "OFL"
category: "DISPLAY"
# Proposed onboarding date; the Google Fonts team assigns the actual date.
date_added: "2026-10-07"
fonts {
  name: "Gothic Gumdrop"
  style: "normal"
  weight: 400
  filename: "GothicGumdrop-Regular.ttf"
  post_script_name: "GothicGumdrop-Regular"
  full_name: "Gothic Gumdrop Regular"
  copyright: "Copyright 2026 The Gothic Gumdrop Project Authors (https://github.com/mixfont/gothic-gumdrop). Copyright 2026 Mixfont (https://www.mixfont.com) and Type Innovations (https://www.typeinnovations.com/). All rights reserved."
}
subsets: "latin"
subsets: "latin-ext"
subsets: "menu"
source {
  repository_url: "https://github.com/mixfont/gothic-gumdrop"
  branch: "main"
  files {
    source_file: "fonts/ttf/GothicGumdrop-Regular.ttf"
    dest_file: "GothicGumdrop-Regular.ttf"
  }
  files {
    source_file: "OFL.txt"
    dest_file: "OFL.txt"
  }
  files {
    source_file: "TRADEMARKS.md"
    dest_file: "TRADEMARKS.md"
  }
  files {
    source_file: "documentation/googlefonts/DESCRIPTION.en_us.html"
    dest_file: "DESCRIPTION.en_us.html"
  }
}
