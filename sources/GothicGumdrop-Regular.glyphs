featurePrefixes = (
{
code = "# GSUB features extracted from GothicGumdrop-Regular.otf v1.102\012# kern, mark and mkmk are generated by ufo2ft/fontmake from kerning.plist and glyph anchors.\012\012languagesystem DFLT dflt;\012languagesystem latn dflt;\012languagesystem latn AZE;\012languagesystem latn CRT;\012languagesystem latn MOL;\012languagesystem latn ROM;\012languagesystem latn TRK;\012# grek is declared so the generated mark/mkmk features also cover Greek runs (pi, mu, Omega...)\012languagesystem grek dflt;\012\012lookup GSUB11 {\012    sub A by ordfeminine;\012    sub O by ordmasculine;\012    sub a by ordfeminine;\012    sub o by ordmasculine;\012} GSUB11;\012\012lookup GSUB12 {\012    sub i by dotlessi;\012    sub j by uni0237;\012    sub iogonek by iogonek.dotless;\012    sub uni030C by caroncomb.alt;\012} GSUB12;\012\012lookup GSUB00 {\012    sub grave by grave.case;\012    sub dieresis by dieresis.case;\012    sub macron by macron.case;\012    sub acute by acute.case;\012    sub circumflex by circumflex.case;\012    sub caron by caron.case;\012    sub breve by breve.case;\012    sub dotaccent by dotaccent.case;\012    sub ring by ring.case;\012    sub tilde by tilde.case;\012    sub hungarumlaut by hungarumlaut.case;\012} GSUB00;\012\012lookup GSUB01 {\012    sub one slash two by onehalf;\012    sub one slash four by onequarter;\012    sub one fraction two by onehalf;\012    sub one fraction four by onequarter;\012    sub three slash four by threequarters;\012    sub three fraction four by threequarters;\012} GSUB01;\012\012lookup GSUB02 {\012    sub s by longs;\012} GSUB02;\012\012lookup GSUB03 {\012    sub f f i by f_f_i;\012    sub f f l by f_f_l;\012    sub f f by f_f;\012    sub f i by fi;\012    sub f l by fl;\012    sub longs t by longs_t;\012} GSUB03;\012\012lookup GSUB04 {\012    sub i by idotaccent;\012} GSUB04;\012\012lookup GSUB05 {\012    sub Scedilla by uni0218;\012    sub scedilla by uni0219;\012    sub uni0162 by uni021A;\012    sub uni0163 by uni021B;\012} GSUB05;\012\012lookup GSUB06 {\012    sub Scedilla by uni0218;\012    sub scedilla by uni0219;\012    sub uni0162 by uni021A;\012    sub uni0163 by uni021B;\012} GSUB06;\012\012lookup GSUB07 {\012    sub [zero one two three four five six seven eight nine] [A a]' lookup GSUB11;\012    sub [zero one two three four five six seven eight nine] [O o]' lookup GSUB11;\012} GSUB07;\012\012lookup GSUB08 {\012    sub caron from [caron.salt];\012} GSUB08;\012\012lookup GSUB09 {\012    sub one by onesuperior;\012    sub two by twosuperior;\012    sub three by threesuperior;\012} GSUB09;\012\012lookup GSUB10 {\012    sub [i j iogonek]' lookup GSUB12 [gravecomb acutecomb uni0302 tildecomb uni0304 uni0306 uni0307 uni0308 uni030A uni030B uni030C];\012    sub [i j iogonek]' lookup GSUB12 [uni0326 uni0327 uni0328] [gravecomb acutecomb uni0302 tildecomb uni0304 uni0306 uni0307 uni0308 uni030A uni030B uni030C];\012    sub [L d l t] uni030C' lookup GSUB12;\012} GSUB10;\012";
name = "<anonymous>";
}
);
