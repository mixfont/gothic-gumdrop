    script DFLT;
    language dflt;
        lookup GSUB07;
    script latn;
    language dflt;
        lookup GSUB07;
    script latn;
    language AZE exclude_dflt;
        lookup GSUB07;
    script latn;
    language CRT exclude_dflt;
