# GSUB features extracted from GothicGumdrop-Regular.otf v1.102
# kern, mark and mkmk are generated by ufo2ft/fontmake from kerning.plist and glyph anchors.

languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem latn AZE;
languagesystem latn CRT;
languagesystem latn MOL;
languagesystem latn ROM;
languagesystem latn TRK;
# grek is declared so the generated mark/mkmk features also cover Greek runs (pi, mu, Omega...)
languagesystem grek dflt;

lookup GSUB11 {
    sub A by ordfeminine;
    sub O by ordmasculine;
    sub a by ordfeminine;
    sub o by ordmasculine;
} GSUB11;

lookup GSUB12 {
    sub i by dotlessi;
    sub j by uni0237;
    sub iogonek by iogonek.dotless;
    sub uni030C by caroncomb.alt;
} GSUB12;

lookup GSUB00 {
    sub grave by grave.case;
    sub dieresis by dieresis.case;
    sub macron by macron.case;
    sub acute by acute.case;
    sub circumflex by circumflex.case;
    sub caron by caron.case;
    sub breve by breve.case;
    sub dotaccent by dotaccent.case;
    sub ring by ring.case;
    sub tilde by tilde.case;
    sub hungarumlaut by hungarumlaut.case;
} GSUB00;

lookup GSUB01 {
    sub one slash two by onehalf;
    sub one slash four by onequarter;
    sub one fraction two by onehalf;
    sub one fraction four by onequarter;
    sub three slash four by threequarters;
    sub three fraction four by threequarters;
} GSUB01;

lookup GSUB02 {
    sub s by longs;
} GSUB02;

lookup GSUB03 {
    sub f f i by f_f_i;
    sub f f l by f_f_l;
    sub f f by f_f;
    sub f i by fi;
    sub f l by fl;
    sub longs t by longs_t;
} GSUB03;

lookup GSUB04 {
    sub i by idotaccent;
} GSUB04;

lookup GSUB05 {
    sub Scedilla by uni0218;
    sub scedilla by uni0219;
    sub uni0162 by uni021A;
    sub uni0163 by uni021B;
} GSUB05;

lookup GSUB06 {
    sub Scedilla by uni0218;
    sub scedilla by uni0219;
    sub uni0162 by uni021A;
    sub uni0163 by uni021B;
} GSUB06;

lookup GSUB07 {
    sub [zero one two three four five six seven eight nine] [A a]' lookup GSUB11;
    sub [zero one two three four five six seven eight nine] [O o]' lookup GSUB11;
} GSUB07;

lookup GSUB08 {
    sub caron from [caron.salt];
} GSUB08;

lookup GSUB09 {
    sub one by onesuperior;
    sub two by twosuperior;
    sub three by threesuperior;
} GSUB09;

lookup GSUB10 {
    sub [i j iogonek]' lookup GSUB12 [gravecomb acutecomb uni0302 tildecomb uni0304 uni0306 uni0307 uni0308 uni030A uni030B uni030C];
    sub [i j iogonek]' lookup GSUB12 [uni0326 uni0327 uni0328] [gravecomb acutecomb uni0302 tildecomb uni0304 uni0306 uni0307 uni0308 uni030A uni030B uni030C];
    sub [L d l t] uni030C' lookup GSUB12;
} GSUB10;

feature case {
    script DFLT;
    language dflt;
        lookup GSUB00;
    script latn;
    language dflt;
        lookup GSUB00;
    script latn;
    language AZE exclude_dflt;
        lookup GSUB00;
    script latn;
    language CRT exclude_dflt;
        lookup GSUB00;
    script latn;
    language MOL exclude_dflt;
        lookup GSUB00;
    script latn;
    language ROM exclude_dflt;
        lookup GSUB00;
    script latn;
    language TRK exclude_dflt;
        lookup GSUB00;
} case;

